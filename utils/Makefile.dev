
MAKEFLAGS += --no-print-directory

TESTS_DIR := ./src/tests
TESTS := $(TESTS_DIR)/parsing/... \
		 $(TESTS_DIR)/hashmap/... \
		 $(TESTS_DIR)/prefix/...

FISH := .github/workflows/fish
AQUARIUM := .github/workflows/aquarium

# Rules
all: server client
	@echo "Build completed"

# Build
install:
	@echo "Downloading dependencies..."
	@go mod download
	@go mod tidy

server:
	@echo "Building Server"
	@go build -o server ./src/cmd/server
	
client:
	@echo "Building Client"
	@go build -o client ./src/cmd/client

# Tests
test:
	@echo "Running tests..."
	@go test $(TESTS) -count=1

test-race:
	@echo "Running race tests..."
	@go test -race $(TESTS) -count=1

test-bubble: all
	@if [ -f $(FISH) ]; then \
		./server > ipc_path.tmp & \
		sleep 1; \
		SERVER_IPC=$$(cat ipc_path.tmp); \
		./client $$SERVER_IPC create test_topic; \
		for i in $$(seq 1 40); do \
			./$(FISH) ./client $$SERVER_IPC test_topic & \
		done; \
		./$(AQUARIUM) ./client $$SERVER_IPC test_topic test_client; \
		rm -f ipc_path.tmp; \
		pkill fish; \
	else \
		echo "No subject attachments found, please download them first."; \
	fi

test-strict:
	@echo "Test eveything..."
	@$(MAKE) test
	@$(MAKE) test-race
	@echo "All tests passed successfully...."

# Manage project
re:
	@$(MAKE) clean
	@$(MAKE) all

format:
	@echo "Format code..."
	@go fmt ./...
	@echo "Linting code..."
	@go vet ./...

lint:
	@echo "Static check code..."
	@GOPATH_BIN="$$(go env GOPATH)/bin"; \
	export PATH="$$PATH:$$GOPATH_BIN"; \
	if ! command -v staticcheck >/dev/null 2>&1; then \
		echo "Error: staticcheck is not installed."; \
		exit 1; \
	fi; \
	staticcheck ./...
	@echo "Dead code check..."
	@GOPATH_BIN="$$(go env GOPATH)/bin"; \
	export PATH="$$PATH:$$GOPATH_BIN"; \
	if ! command -v deadcode >/dev/null 2>&1; then \
		echo "Error: deadcode is not installed (run: go install golang.org/x/tools/cmd/deadcode@latest)"; \
		exit 1; \
	fi; \
	DEAD_FUNCS=$$(deadcode -test ./...); \
	if [ -n "$$DEAD_FUNCS" ]; then \
		echo "Error: Unused functions detected:"; \
		echo "$$DEAD_FUNCS"; \
		exit 1; \
	fi
	@echo "Check lint..."
	@test -z "$$(gofmt -l .)" || (echo "Error: Incorrect lint !" && exit 1)

gitinette:
	@./.github/workflows/gitinette

check:
	@echo "Running full project check..."
	@$(MAKE) gitinette
	@$(MAKE) format
	@$(MAKE) lint
	@$(MAKE) re
	@$(MAKE) test-strict
	@$(MAKE) clean
	@echo "All checks passed successfully."

stats:
	@echo "Go files: $$(find . -name "*.go" -type f | wc -l)"
	@echo "Total lines: $$(find . -name "*.go" -type f -exec cat {} + | wc -l)"

# Clean
clean:
	@rm -rf server client


.PHONY: all install server client test test-race test-strict re format lint gitinette check stats clean
