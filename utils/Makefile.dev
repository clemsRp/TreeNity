
MAKEFLAGS += --no-print-directory

TESTS_DIR := ./src/tests
TESTS := $(TESTS_DIR)/parsing/... \
		 $(TESTS_DIR)/hashmap/... \
		 $(TESTS_DIR)/prefix/...

# Rules
all: server client
	@echo "Build completed"

# Build
install:
	@echo "Downloading dependencies..."
	@go mod download
	@go mod tidy

server:
	@echo "Building Server"
	@go build -o server ./src/cmd/server
	
client:
	@echo "Building Client"
	@go build -o client ./src/cmd/client

# Tests
test:
	@echo "Running tests..."
	@go test $(TESTS) -count=1

test-race:
	@echo "Running race tests..."
	@go test -race $(TESTS) -count=1

test-strict:
	@echo "Test eveything..."
	@$(MAKE) test
	@$(MAKE) test-race
	@echo "All tests passed successfully...."

# Manage project
re:
	@$(MAKE) clean
	@$(MAKE) all

format:
	@echo "Format code..."
	@go fmt ./...
	@echo "Linting code..."
	@go vet ./...

lint:
	@echo "Static check code..."
	@PATH="$$PATH:$$(go env GOPATH)/bin" which staticcheck >/dev/null 2>&1 && PATH="$$PATH:$$(go env GOPATH)/bin" staticcheck ./... || true
	@echo "Check lint..."
	@test -z "$(gofmt -l src)" || (echo "Error: Incorrect lint !" && exit 1)

gitinette:
	@./.github/workflows/gitinette

check:
	@echo "Running full project check..."
	@$(MAKE) gitinette
	@$(MAKE) format
	@$(MAKE) lint
	@$(MAKE) re
	@$(MAKE) test-strict
	@$(MAKE) clean
	@echo "All checks passed successfully."

stats:
	@echo "Go files: $$(find . -name "*.go" -type f | wc -l)"
	@echo "Total lines: $$(find . -name "*.go" -type f -exec cat {} + | wc -l)"

# Clean
clean:
	@rm -rf server client


.PHONY: all install server client test test-race test-strict re format lint gitinette check stats clean
